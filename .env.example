# NVIDIA NIM hosted API credentials
NVIDIA_NIM_API_KEY=your_api_key

# Optional overrides
# DeepSeek V4 Flash is configured by default for fast low-effort reasoning.
# NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4-flash-0731
# Set to high or max when deeper reasoning is more important than latency.
# NVIDIA_NIM_REASONING_EFFORT=low
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
